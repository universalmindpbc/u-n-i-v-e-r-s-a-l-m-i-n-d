Options -MultiViews
DirectoryIndex index.html
AddType application/vnd.apple.pkpass .pkpass

# The app shell changes frequently during staging reviews. Keep HTML fresh while
# content-hashed styles, scripts and media retain their normal cache behaviour.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

RewriteEngine On

# BEGIN Portal navigation compatibility
RewriteCond %{QUERY_STRING} !(^|&)(adaptiveFrame|musicTelevisionFrame|navigationShell|embedded)=1(&|$) [NC]
RewriteCond %{THE_REQUEST} \s/+vogue/iam/[^?\s]+ [NC]
RewriteRule ^vogue/iam/(about\.html|business\-model\.html|impact\.html|index\.html|light\.html|our\-team\.html|privacy\-first\.html|program\.html|research\.html|science\.html|shop\.html|technology\-citizen\-needs\.html|technology\-inference\-engine\.html|traction\.html|vogue\-self\-report\.html)$ site-navigation/legacy.php [L]
# Preserve the existing lightweight phone entry for TV and check-in.
RewriteCond %{HTTP_USER_AGENT} !(iPad|Macintosh.*Mobile) [NC]
RewriteCond %{HTTP_USER_AGENT} (Mobile|iPhone|iPod|IEMobile|Opera\ Mini|BlackBerry|webOS) [NC]
RewriteCond %{QUERY_STRING} !(^|&)full=1(&|$) [NC]
RewriteRule ^iam/(tv|check-in|technology(?:/recommendations)?)/?$ /vogue/iam/induction.html?mobile=1 [R=302,L,NE]
# END Portal navigation compatibility


# Confidential source material is never a public asset, even if a stale copy exists.
RewriteRule (^|/)s[[:space:]]o[[:space:]]v[[:space:]]e[[:space:]]r[[:space:]]e[[:space:]]i[[:space:]]g[[:space:]]n[[:space:]]t[[:space:]]y(/|$) - [F,L,NC]
RewriteRule (^|/)\.private(/|$) - [F,L]

# Smartphone visitors receive the lightweight editorial surface while the
# full media application remains available on desktop and tablet. `full=1`
# is the private QA escape hatch for deliberate phone testing.
RewriteCond %{HTTP_USER_AGENT} !(iPad|Macintosh.*Mobile) [NC]
RewriteCond %{HTTP_USER_AGENT} "(Mobile|iPhone|iPod|IEMobile|Opera Mini|BlackBerry|webOS)" [NC]
RewriteCond %{QUERY_STRING} !(^|&)full=1(&|$) [NC]
RewriteRule ^shop/?$ /vogue/iam/shop.html [R=302,L,NE]

RewriteCond %{HTTP_USER_AGENT} !(iPad|Macintosh.*Mobile) [NC]
RewriteCond %{HTTP_USER_AGENT} "(Mobile|iPhone|iPod|IEMobile|Opera Mini|BlackBerry|webOS)" [NC]
RewriteCond %{QUERY_STRING} !(^|&)full=1(&|$) [NC]
RewriteCond %{QUERY_STRING} (^|&)shop=1(&|$) [NC]
RewriteRule ^vogue/iam/index\.html$ /vogue/iam/shop.html [R=302,L,NE]

RewriteCond %{HTTP_USER_AGENT} !(iPad|Macintosh.*Mobile) [NC]
RewriteCond %{HTTP_USER_AGENT} "(Mobile|iPhone|iPod|IEMobile|Opera Mini|BlackBerry|webOS)" [NC]
RewriteCond %{QUERY_STRING} !(^|&)full=1(&|$) [NC]
RewriteCond %{REQUEST_URI} !^/vogue/iam/(induction|about|program|science|research|light|privacy-first|business-model|traction|impact|our-team|shop|shop-science)\.html$ [NC]
RewriteRule ^vogue/iam/.*\.html$ /vogue/iam/induction.html?mobile=1 [R=302,L,NE]

# Password-free Universal Mind I AM entrypoints.
RewriteRule ^light/?$ /vogue/iam/light.html [L]
RewriteRule ^study/dashboard/?$ /vogue/iam/study.php?dashboard=1 [R=302,L,NE]
RewriteRule ^study/?$ /vogue/iam/study.php?login=1 [R=302,L,NE,QSA]
RewriteRule ^wallet/?$ /vogue/iam/wallet.html [L]
RewriteRule ^shop/?$ /vogue/iam/index.html?shop=1 [R=302,L,NE]
RewriteRule ^iam/?$ /vogue/iam/induction.html [R=302,L]
RewriteRule ^vogue/?$ /vogue/iam/induction.html [R=302,L]
RewriteRule ^vogue/iam/?$ /vogue/iam/induction.html [R=302,L]

# If a deploy does not contain physical /vogue/iam files, fall back to the local source folder.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^vogue/iam/(.+)$ /i%20%20a%20m/$1 [B,L]
