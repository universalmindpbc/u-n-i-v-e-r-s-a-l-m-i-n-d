{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectAccountAndCosts",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "pricing:GetProducts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectRdsPrototypeCatalog",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBEngineVersions",
        "rds:DescribeOrderableDBInstanceOptions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectCitizenDataCapacityMetric",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "*"
    },
    {
      "Sid": "ValidateSyntheticCitizenObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::universal-mind-citizen-da-*/synthetic-service-validation/*"
    },
    {
      "Sid": "InspectSyntheticCitizenObjectVersionsOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucketVersions",
      "Resource": "arn:aws:s3:::universal-mind-citizen-da-*",
      "Condition": {
        "StringLike": {
          "s3:prefix": "synthetic-service-validation/*"
        }
      }
    },
    {
      "Sid": "InspectPrototypeBudgets",
      "Effect": "Allow",
      "Action": "budgets:ViewBudget",
      "Resource": "arn:aws:budgets::*:budget/*"
    },
    {
      "Sid": "ManagePrototypeBudget",
      "Effect": "Allow",
      "Action": "budgets:ModifyBudget",
      "Resource": "arn:aws:budgets::*:budget/universal-mind-prototype-monthly"
    },
    {
      "Sid": "ManageCitizenDataCloudFormation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:CreateStack",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListChangeSets",
        "cloudformation:ListStackResources",
        "cloudformation:UpdateStack",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProvisionCitizenDataFoundation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateSubnet",
        "ec2:CreateTags",
        "ec2:CreateVpc",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVpcAttribute",
        "kms:CreateAlias",
        "kms:CreateGrant",
        "kms:CreateKey",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:EnableKeyRotation",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListAliases",
        "kms:ListResourceTags",
        "kms:PutKeyPolicy",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo",
        "kms:TagResource",
        "rds:AddTagsToResource",
        "rds:CreateDBCluster",
        "rds:CreateDBInstance",
        "rds:CreateDBSubnetGroup",
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "rds:DescribeDBSubnetGroups",
        "rds:ListTagsForResource",
        "rds-data:BatchExecuteStatement",
        "rds-data:BeginTransaction",
        "rds-data:CommitTransaction",
        "rds-data:ExecuteStatement",
        "rds-data:RollbackTransaction",
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketVersioning",
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketLogging",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DeleteCitizenDataStagingStackOnly",
      "Effect": "Allow",
      "Action": "cloudformation:DeleteStack",
      "Resource": "arn:aws:cloudformation:ap-southeast-2:*:stack/universal-mind-citizen-data-staging/*"
    },
    {
      "Sid": "ManageCitizenDataSecurityGroupEgressOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:*:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/application": "universal-mind",
          "ec2:ResourceTag/environment": "staging"
        }
      }
    },
    {
      "Sid": "DeleteCitizenDataSubnetGroupOnly",
      "Effect": "Allow",
      "Action": "rds:DeleteDBSubnetGroup",
      "Resource": "arn:aws:rds:ap-southeast-2:*:subgrp:universal-mind-citizen-data-staging-*"
    },
    {
      "Sid": "DeleteCitizenDataKeyAliasOnly",
      "Effect": "Allow",
      "Action": "kms:DeleteAlias",
      "Resource": "arn:aws:kms:ap-southeast-2:*:alias/universal-mind-citizen-data-staging"
    },
    {
      "Sid": "DeleteCitizenDataAliasFromTaggedKeyOnly",
      "Effect": "Allow",
      "Action": "kms:DeleteAlias",
      "Resource": "arn:aws:kms:ap-southeast-2:*:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/application": "universal-mind",
          "aws:ResourceTag/environment": "staging"
        }
      }
    },
    {
      "Sid": "DeleteCitizenDataBucketPoliciesOnly",
      "Effect": "Allow",
      "Action": "s3:DeleteBucketPolicy",
      "Resource": "arn:aws:s3:::universal-mind-citizen-da-*"
    },
    {
      "Sid": "CreateRdsServiceLinkedRoleOnly",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "rds.amazonaws.com"
        }
      }
    }
  ]
}
