{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spacetime Mini Tensor kernel v1",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_date",
    "status",
    "dimensions",
    "provenance",
    "series",
    "models",
    "analysis_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "spacetime-mini-tensor/1.1.0"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "data_ready_analysis_not_run"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "units",
          "cadence",
          "source",
          "source_sha256",
          "observations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "observation",
              "derived_observation"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "interval_start",
                "interval_end_exclusive",
                "value",
                "valid",
                "available_at"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "interval_start": {
                  "type": "string",
                  "format": "date-time"
                },
                "interval_end_exclusive": {
                  "type": "string",
                  "format": "date-time"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "valid": {
                  "type": "boolean"
                },
                "available_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "value": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 3
    },
    "analysis_contract": {
      "type": "object",
      "required": [
        "status",
        "results",
        "concepts",
        "preparation",
        "validation",
        "agent_protocol",
        "outcome_vocabulary"
      ],
      "properties": {
        "status": {
          "const": "not_run"
        },
        "results": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
