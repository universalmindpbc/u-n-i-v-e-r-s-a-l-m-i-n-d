# The same public source is proofed on staging; indexing stays disabled there.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^staging\.universalmind\.tv(:[0-9]+)?$" informatics_staging=1
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=informatics_staging
</IfModule>

# Chapter URLs retain the interactive portal; embedded applications keep their own documents.
RewriteEngine On
RewriteCond %{QUERY_STRING} !(^|&)(embedded|adaptiveFrame|musicTelevisionFrame)=1(&|$) [NC]
RewriteCond %{QUERY_STRING} (^|&)(area=(about|geometry|transcription|molecular|quantum|sound|vision|language|research|connect|partners)|atlas=1|about(?:=|&|$)) [NC]
RewriteRule ^(?:index\.html)?$ /site-navigation/legacy.php [L]
RewriteCond %{QUERY_STRING} !(^|&)(embedded|adaptiveFrame|musicTelevisionFrame)=1(&|$) [NC]
RewriteRule ^(library\.html|connect\.html|research\.html|genomics\.html|molecular/index\.html|quantum/index\.html)$ /site-navigation/legacy.php [L]
RewriteRule ^(about|geometry|transcription|molecular|quantum|sound|vision|language|research|connect|partners)$ /informatics/$1/ [R=301,L,NE]
RewriteCond %{QUERY_STRING} !(^|&)embedded=1(&|$) [NC]
RewriteRule ^(about|geometry|transcription|molecular|quantum|sound|vision|language|research|connect|partners)/$ chapters/$1.html [L]
