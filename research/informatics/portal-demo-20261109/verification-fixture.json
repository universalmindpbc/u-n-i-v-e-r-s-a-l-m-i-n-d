    "code": "Module[{n=2,pairs={{1,2}},coupling={158.0338616606429},bits,diag,op,mat,omega,delta,phase,t,y,sol,p,hermitian},omega=Interpolation[{{0.0,0.0},{0.09999999999999999,6.3},{3.9,6.3},{4.0,0.0}},InterpolationOrder->1];delta=Interpolation[{{0.0,-31.5},{0.09999999999999999,-31.5},{3.9,31.5},{4.0,31.5}},InterpolationOrder->1];phase=Interpolation[{{0.0,0.0},{0.09999999999999999,0.0},{3.9,0.0},{4.0,0.0}},InterpolationOrder->1];bits=Table[BitGet[i,q],{i,0,2^n-1},{q,0,n-1}];diag=Table[Sum[coupling[[k]] bits[[i,pairs[[k,1]]]] bits[[i,pairs[[k,2]]]],{k,Length[pairs]}],{i,2^n}];mat[t_?NumericQ]:=SparseArray[Join[Table[{i,i}->(diag[[i]]-delta[t] Total[bits[[i]]]),{i,2^n}],Flatten[Table[{i+1,BitXor[i,2^q]+1}->(omega[t]/2 Exp[I phase[t](1-2 BitGet[i,q])]),{i,0,2^n-1},{q,0,n-1}],1]],{2^n,2^n}];op=PacletSymbol[\"Wolfram/QuantumFramework\",\"QuantumOperator\"][mat[2.0]];hermitian=Max[Abs[Flatten[Normal[op[\"Matrix\"]-ConjugateTranspose[op[\"Matrix\"]]]]]]<10^-10;sol=NDSolveValue[{y'[t]==-I mat[t].y[t],y[0]==UnitVector[2^n,1]},y,{t,0,4.0},AccuracyGoal->9,PrecisionGoal->8,MaxStepFraction->1/1000];p=Abs[sol[4.0]]^2;ExportString[<|\"framework\"->ToString[Head[op],InputForm],\"dimension\"->Dimensions[op[\"Matrix\"]],\"hermitian\"->hermitian,\"probabilities\"->p,\"probability_sum\"->Total[p]|>,\"RawJSON\"]]",
